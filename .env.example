LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
WEB_PORT=8000
WEB_BIND=127.0.0.1
WEB_WORKERS=2
# Optional generation and search settings; empty means the solution default.
LLM_REASONING_EFFORT=
MAX_TOKENS=
TEMPERATURE=
TOP_K=
# Embedding model through the same proxy (e.g. bge-m3); empty means lexical search only.
EMB_MODEL=
PSB_DENSE_SECONDS=
# Secret shared with the authenticated reverse proxy (never send it to the browser).
# Set X-Chat-User to the verified login and X-Chat-Token to this value at the proxy.
CHAT_PROXY_TOKEN=
